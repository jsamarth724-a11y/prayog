# Primary scanning & analysis engine: "groq" (or switch to "openrouter" for Claude)
AI_PROVIDER=groq

# Groq API Configuration (Fast frame scanning & analysis)
# Get key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter Configuration (Claude)
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

PORT=3001
AI_TIMEOUT_MS=25000

# SQLite database location (default: ./data/visionops.db)
# VISION_OPS_DB_PATH=C:\path\to\visionops.db

# Multimodal Sensor Intelligence (Phase 5).
# Registration/calibration require a random administrator secret of at least 24 characters.
# Generate one locally, keep it out of source control, and give each device its own
# one-time credential returned by POST /api/sensors.
# SENSOR_ADMIN_TOKEN=
# Device readings are rate-limited to one per sensor per 10 seconds by default.
SENSOR_MIN_INTERVAL_MS=10000
# Health transitions are checked periodically; sensor values older than the stale
# deadline are unavailable to fusion, and older than the disconnect deadline are
# reported disconnected. These are status deadlines, not normal-value assumptions.
SENSOR_HEALTH_POLL_MS=15000
SENSOR_STALE_AFTER_MS=60000
SENSOR_DISCONNECTED_AFTER_MS=300000
SENSOR_FUSION_FRESH_MS=120000
# Deterministic virtual sensor sample interval; 0.25x–4x session speeds are available.
SIMULATION_INTERVAL_MS=5000
# Initial generic thresholds; set machine-specific thresholds before relying on alerts.
SENSOR_SOUND_WARNING_DB=85
SENSOR_SOUND_CRITICAL_DB=105
SENSOR_VIBRATION_WARNING_G=0.5
SENSOR_VIBRATION_CRITICAL_G=1
SENSOR_TEMPERATURE_WARNING_C=70
SENSOR_TEMPERATURE_CRITICAL_C=85
SENSOR_SMOKE_WARNING_PPM=10
SENSOR_SMOKE_CRITICAL_PPM=50

# Failure trend intelligence (all settings have safe defaults in trend/config.mjs).
# Windows are measured in valid analysis observations, not wall-clock intervals.
# RISK_LOW_THRESHOLD=20
# RISK_MODERATE_THRESHOLD=40
# RISK_HIGH_THRESHOLD=60
# RISK_CRITICAL_THRESHOLD=80
# TREND_SHORT_WINDOW=3
# TREND_LONG_WINDOW=5
# TREND_BASELINE_WINDOW=30
# TREND_MIN_OBSERVATIONS=5
# TREND_RISING_SLOPE=1
# TREND_RAPID_SLOPE=5
# TREND_MIN_DELTA=3
# TREND_PERSISTENT_HIGH_SCORE=70
# TREND_PERSISTENT_COUNT=3
# TREND_MAX_GAP_HOURS=24
# WARNING_GRADUAL_MIN_OBSERVATIONS=5
# TREND_MODERATE_WINDOW=10
# WARNING_MODERATE_COUNT=3
# WARNING_MODERATE_MIN_OBSERVATIONS=5
# WARNING_SPIKE_BASELINE_WINDOW=5
# WARNING_SPIKE_INCREASE=20
# WARNING_SPIKE_MIN_OBSERVATIONS=6
# TREND_FAILURE_WINDOW=10
# WARNING_FAILURE_COUNT=2
# WARNING_FAILURE_MIN_OBSERVATIONS=5
# WARNING_BASELINE_MIN_OBSERVATIONS=8
# WARNING_BASELINE_RECENT_WINDOW=3
# WARNING_BASELINE_ZSCORE=2
# WARNING_BASELINE_MIN_DEVIATION=15
# WARNING_MIN_CONFIDENCE=0.35
# WARNING_FULL_SEVERITY_CONFIDENCE=0.6

# Watch Guard normally sends two images per analysis — the current frame plus the
# previous one — so the model can spot frame-to-frame change. On Groq's free tier
# that pair costs about 8300 tokens against an 8000 tokens-per-minute limit, so
# every request after the first fails with "request too large". The server detects
# this and falls back to sending the current frame alone for the rest of the run.
# Set this to false to start in single-frame mode and skip the one failed request.
SEND_REFERENCE_IMAGE=true

# How many consecutive "needs_attention" frames in a row before a failure counts
# as confirmed (triggers the Discord webhook and printer auto-pause below).
CONFIRMATION_STREAK=3

# Discord incoming-webhook URL. This is the only thing you need to fill in to
# get alerts: Discord > Server Settings > Integrations > Webhooks > New Webhook
# > Copy Webhook URL. Leave blank to disable notifications entirely.
# Test it with: curl -X POST http://localhost:3001/api/notifications/test
DISCORD_WEBHOOK_URL=

# Who to ping on a confirmed failure or a crash. Use <@YOUR_USER_ID> for a DM-style
# ping, <@&ROLE_ID> for a role, or @here / @everyone. Leave blank for no ping.
# (Your user ID: enable Developer Mode in Discord, then right-click yourself > Copy User ID.)
DISCORD_MENTION=

# Also alert on runtime errors (Groq rejecting requests, rate limits, bad JSON,
# a printer that would not pause, a server crash) — not just print failures.
DISCORD_NOTIFY_ERRORS=true

# Post a follow-up when a camera that was in a confirmed failure goes back to normal.
DISCORD_NOTIFY_RECOVERY=true

# Attach the camera frame that triggered the failure to the Discord message.
DISCORD_ATTACH_SNAPSHOT=true

# Post a message when the server boots. Off by default to keep the channel quiet.
DISCORD_NOTIFY_STARTUP=false

# How much gets posted:
#   warnings  - every distinct problem the moment it is seen, plus the louder
#               "confirmed" alert once CONFIRMATION_STREAK frames agree (default)
#   confirmed - only confirmed failures. Quietest, but a fault that flickers
#               never reaches the streak and is never reported at all.
#   all       - every analysed frame, including clean ones. Debugging only; this
#               will post continuously while monitoring runs.
DISCORD_ALERT_LEVEL=warnings

# While a problem persists unchanged, repeat the alert this often so a fault
# left running overnight keeps reminding you. Default 10 minutes.
DISCORD_REPEAT_MS=600000

# Anti-spam. Repeats of the same alert inside these windows are collapsed, and
# the suppressed count is reported on the next message that goes out. Warnings
# and failures default to 0 because repeats are already held back by state-change
# detection — a message is sent when the problem changes, not once per frame.
DISCORD_ERROR_COOLDOWN_MS=60000
DISCORD_FAILURE_COOLDOWN_MS=0
DISCORD_WARNING_COOLDOWN_MS=0

# Name the bot posts under.
DISCORD_USERNAME=Watch Guard

# Optional: automatically pause the machine on a confirmed failure.
# Set to "octoprint" or "moonraker", or leave as "none" to disable.
PRINTER_DRIVER=none
OCTOPRINT_URL=
OCTOPRINT_API_KEY=
MOONRAKER_URL=
